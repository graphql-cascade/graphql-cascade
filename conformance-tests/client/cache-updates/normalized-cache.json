{
  "id": "TC-C-001",
  "name": "Normalized Cache Writes Updated Entities",
  "description": "A normalized cache writes each updated entity under its typename and id, replacing the fields it holds.",
  "category": "client",
  "subcategory": "cache-updates",
  "requirement": "REQ-101",
  "level": "basic",
  "priority": "critical",
  "input": {
    "state": {
      "entities": [
        {
          "__typename": "User",
          "id": "u1",
          "name": "Ada",
          "email": "ada@example.com"
        }
      ]
    },
    "result": {
      "success": true,
      "errors": [],
      "data": {
        "__typename": "User",
        "id": "u1",
        "name": "Ada Lovelace",
        "email": "ada@example.com"
      },
      "cascade": {
        "updated": [
          {
            "typename": "User",
            "id": "u1",
            "operation": "UPDATED",
            "entity": {
              "__typename": "User",
              "id": "u1",
              "name": "Ada Lovelace",
              "email": "ada@example.com"
            }
          }
        ],
        "deleted": [],
        "invalidations": [],
        "typeInvalidations": [],
        "metadata": {
          "timestamp": "2026-01-01T00:00:00Z",
          "depth": 1,
          "affectedCount": 1,
          "truncated": false
        }
      }
    }
  },
  "expected": {
    "entities": {
      "User:u1": {
        "name": "Ada Lovelace",
        "email": "ada@example.com"
      }
    }
  },
  "tags": [
    "normalized-cache"
  ]
}
