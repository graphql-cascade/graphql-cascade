{
  "id": "TC-C-021",
  "name": "Updated Entities Apply In Place",
  "description": "Clients SHOULD NOT invalidate or refetch a cached query only because it contains an updated entity: the cascade carries the entity's full data, so queries that contain it read the new data from the cache without a network request",
  "category": "client",
  "subcategory": "cache-updates",
  "requirement": "REQ-031",
  "priority": "medium",
  "input": {
    "clientState": {
      "cache": {
        "User:1": { "__typename": "User", "id": "1", "name": "John" },
        "Post:1": { "__typename": "Post", "id": "1", "title": "Hello", "authorId": "1" }
      },
      "queries": [
        { "query": "getUser", "variables": { "id": "1" }, "result": { "user": { "__typename": "User", "id": "1" } } },
        { "query": "getPosts", "variables": {}, "result": { "posts": [{ "__typename": "Post", "id": "1", "author": { "__typename": "User", "id": "1" } }] } }
      ]
    },
    "cascade": {
      "updated": [{ "typename": "User", "id": "1", "name": "John Updated" }],
      "invalidations": [],
      "metadata": { "affectedCount": 1, "operationType": "UPDATE" }
    }
  },
  "expected": {
    "clientState": {
      "cache": {
        "User:1": { "__typename": "User", "id": "1", "name": "John Updated" }
      },
      "invalidatedQueries": []
    }
  },
  "tags": ["cache-update", "performance", "no-refetch"]
}
