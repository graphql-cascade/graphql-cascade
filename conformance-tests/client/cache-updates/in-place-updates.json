{
  "id": "TC-C-021",
  "name": "Updated Entities Do Not Invalidate Queries",
  "description": "Queries are not invalidated only because they contain an updated entity; they read its new data from the cache.",
  "category": "client",
  "subcategory": "cache-updates",
  "requirement": "REQ-031",
  "level": "standard",
  "priority": "high",
  "input": {
    "state": {
      "entities": [
        {
          "__typename": "User",
          "id": "u1",
          "name": "Ada",
          "email": "ada@example.com"
        }
      ],
      "queries": [
        {
          "name": "users",
          "result": [
            {
              "__typename": "User",
              "id": "u1",
              "name": "Ada",
              "email": "ada@example.com"
            },
            {
              "__typename": "User",
              "id": "u2",
              "name": "Grace",
              "email": "grace@example.com"
            }
          ]
        },
        {
          "name": "user",
          "arguments": {
            "id": "u1"
          },
          "result": {
            "__typename": "User",
            "id": "u1",
            "name": "Ada",
            "email": "ada@example.com"
          }
        }
      ]
    },
    "result": {
      "success": true,
      "errors": [],
      "data": {
        "__typename": "User",
        "id": "u1",
        "name": "Ada Lovelace",
        "email": "ada@example.com"
      },
      "cascade": {
        "updated": [
          {
            "typename": "User",
            "id": "u1",
            "operation": "UPDATED",
            "entity": {
              "__typename": "User",
              "id": "u1",
              "name": "Ada Lovelace",
              "email": "ada@example.com"
            }
          }
        ],
        "deleted": [],
        "invalidations": [],
        "typeInvalidations": [],
        "metadata": {
          "timestamp": "2026-01-01T00:00:00Z",
          "depth": 1,
          "affectedCount": 1,
          "truncated": false
        }
      }
    }
  },
  "expected": {
    "queries": [
      {
        "name": "users",
        "state": "fresh"
      },
      {
        "name": "user",
        "arguments": {
          "id": "u1"
        },
        "state": "fresh",
        "result": {
          "name": "Ada Lovelace"
        }
      }
    ]
  },
  "tags": [
    "no-overfetch"
  ]
}
