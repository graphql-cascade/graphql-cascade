{
  "id": "TC-C-002",
  "name": "Cached Results Show Updated Entities",
  "description": "Every cached query result containing an updated entity shows the entity's new data.",
  "category": "client",
  "subcategory": "cache-updates",
  "requirement": "REQ-102",
  "level": "basic",
  "priority": "critical",
  "input": {
    "state": {
      "queries": [
        {
          "name": "users",
          "result": [
            {
              "__typename": "User",
              "id": "u1",
              "name": "Ada",
              "email": "ada@example.com"
            },
            {
              "__typename": "User",
              "id": "u2",
              "name": "Grace",
              "email": "grace@example.com"
            }
          ]
        }
      ]
    },
    "result": {
      "success": true,
      "errors": [],
      "data": {
        "__typename": "User",
        "id": "u1",
        "name": "Ada Lovelace",
        "email": "ada@example.com"
      },
      "cascade": {
        "updated": [
          {
            "typename": "User",
            "id": "u1",
            "operation": "UPDATED",
            "entity": {
              "__typename": "User",
              "id": "u1",
              "name": "Ada Lovelace",
              "email": "ada@example.com"
            }
          }
        ],
        "deleted": [],
        "invalidations": [],
        "typeInvalidations": [],
        "metadata": {
          "timestamp": "2026-01-01T00:00:00Z",
          "depth": 1,
          "affectedCount": 1,
          "truncated": false
        }
      }
    }
  },
  "expected": {
    "queries": [
      {
        "name": "users",
        "state": "fresh",
        "result": [
          {
            "id": "u1",
            "name": "Ada Lovelace"
          },
          {
            "id": "u2",
            "name": "Grace"
          }
        ]
      }
    ]
  },
  "tags": [
    "document-cache"
  ]
}
