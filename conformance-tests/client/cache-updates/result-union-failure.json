{
  "id": "TC-C-006",
  "name": "CascadeFailure Applies Nothing",
  "description": "A CascadeFailure means nothing was committed: the cache stays as it was.",
  "category": "client",
  "subcategory": "result-unions",
  "requirement": "REQ-105",
  "level": "basic",
  "priority": "high",
  "input": {
    "state": {
      "entities": [
        {
          "__typename": "User",
          "id": "u1",
          "name": "Ada",
          "email": "ada@example.com"
        }
      ],
      "queries": [
        {
          "name": "user",
          "arguments": {
            "id": "u1"
          },
          "result": {
            "__typename": "User",
            "id": "u1",
            "name": "Ada",
            "email": "ada@example.com"
          }
        }
      ]
    },
    "result": {
      "__typename": "CascadeFailure",
      "errors": [
        {
          "message": "Name already taken",
          "code": "CONFLICT",
          "field": "name"
        }
      ]
    }
  },
  "expected": {
    "entities": {
      "User:u1": {
        "name": "Ada"
      }
    },
    "queries": [
      {
        "name": "user",
        "arguments": {
          "id": "u1"
        },
        "state": "fresh"
      }
    ]
  },
  "tags": [
    "result-unions"
  ]
}
