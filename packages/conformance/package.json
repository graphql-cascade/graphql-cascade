{
  "name": "@graphql-cascade/conformance",
  "version": "0.3.1",
  "description": "Runs the GraphQL Cascade specification's conformance cases against servers and clients",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cascade-conformance": "./dist/cli.js"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest --maxWorkers=50% --coverage",
    "dev": "tsc --watch"
  },
  "keywords": [
    "graphql",
    "cascade",
    "conformance",
    "testing"
  ],
  "author": "GraphQL Cascade Team",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@graphql-cascade/client": "workspace:*",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  }
}
