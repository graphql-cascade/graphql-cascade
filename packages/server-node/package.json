{
  "name": "@graphql-cascade/server",
  "version": "0.3.1",
  "description": "GraphQL Cascade server implementation for Node.js/TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nestjs": {
      "types": "./dist/integrations/nestjs.d.ts",
      "default": "./dist/integrations/nestjs.js"
    },
    "./express": {
      "types": "./dist/integrations/express.d.ts",
      "default": "./dist/integrations/express.js"
    },
    "./apollo": {
      "types": "./dist/integrations/apollo.d.ts",
      "default": "./dist/integrations/apollo.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "nestjs": [
        "dist/integrations/nestjs.d.ts"
      ],
      "express": [
        "dist/integrations/express.d.ts"
      ],
      "apollo": [
        "dist/integrations/apollo.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "jest --maxWorkers=50% --coverage && node --test test/nestjs.test.mjs",
    "test:mutation": "stryker run",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "graphql",
    "cascade",
    "cache",
    "mutations",
    "typescript",
    "server"
  ],
  "author": "GraphQL Cascade Team",
  "license": "MIT",
  "dependencies": {
    "graphql": "^16.6.0"
  },
  "devDependencies": {
    "@apollo/server": "^4.9.0",
    "@graphql-cascade/conformance": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@stryker-mutator/core": "^9.4.0",
    "@stryker-mutator/jest-runner": "^9.4.0",
    "@stryker-mutator/typescript-checker": "^9.4.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "express": "^4.22.1",
    "fast-check": "^3.23.2",
    "jest": "^29.6.0",
    "reflect-metadata": "^0.2.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@apollo/server": "^4.0.0 || ^5.0.0",
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "express": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@apollo/server": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/graphql-cascade/graphql-cascade.git",
    "directory": "packages/server-node"
  },
  "bugs": {
    "url": "https://github.com/graphql-cascade/graphql-cascade/issues"
  },
  "homepage": "https://github.com/graphql-cascade/graphql-cascade#readme"
}
