{
  "name": "@graphql-cascade/apollo",
  "version": "0.3.1",
  "description": "Apollo Client integration for GraphQL Cascade",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "dist/core.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest --maxWorkers=50% --coverage",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "graphql",
    "cascade",
    "apollo",
    "client"
  ],
  "author": "GraphQL Cascade Team",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@graphql-cascade/client": "workspace:*"
  },
  "peerDependencies": {
    "@apollo/client": "^3.0.0 || ^4.0.0",
    "graphql": "^16.0.0 || ^17.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apollo/client": "^3.14.0",
    "@graphql-cascade/conformance": "workspace:*",
    "@testing-library/react": "^13.4.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.0",
    "graphql": "^16.12.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "react": "^18.3.1",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  }
}
